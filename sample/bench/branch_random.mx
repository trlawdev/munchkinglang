package branch_random

// Mixed conditions — hard for any predictor (including perceptron).
limit = 1000000
hits = 0
index = 0
loop index < limit {
    // xorshift-ish mix without heavy ops
    seed = index * 1103515245 + 12345
    if seed % 2 == 0 {
        hits = hits + 1
    }
    index = index + 1
}

print("hits=", hits)
println("")
