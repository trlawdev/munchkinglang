package reflexpr_

//munx has only compile time reflection
// 
object Detail {
    some_info: string
}

object Person {
    name: string,
    age: int,
    height: float,
    detail: Detail
}



func serialize<T>(p: T): void { // T is a generic type
    refl_artifact = ::reflexpr(p) // ::reflexpr is a keyword, it reflects on object types and functions or lambdas, if a value is passed it reflect on the
    // type of the value passed, Returns a ObjectReflectionArtifact
    members = ::members(refl_artifact) // ::members is a keyword, returns a ObjectFieldReflectionArtifactArray
    ::reflect_for(member of members) { //::reflect_for is a keyword for a loop through an array of FieldReflectionArtifact (ObjectFieldReflectionArtifactArray)
        ::match member.type { //.type is a field of an opaque type ObjectFieldReflectionArtifact that returns a typeid another opaque compiler representation of the type
            ::case typeid(object) => println("object member: ", member.name) //.name is a field on the opaque ObjectFieldReflectionArtifact type that returns a string of the name of the field
            ::default => println("primitive member: ", member.name)
        }
    }
}

p = Person("dummy name", 2, 10.23, Detail("some detail"))
// Type args may be explicit (`serialize<Person>(p)`) or inferred:
serialize(p)

func add<T>(x: T, y: T): T {
    return x + y;
}

refl_func = ::reflexpr(add) //FunctionReflectionAritifact
println("Meta Function name: ", refl_func.name, " owning package: ", refl_func.package_name)
if refl_func.is_meta_function { //is_meta_function checks if a FunctionReflectionAritifact is a meta function, a meta function is a function with generic type parameters
    generic_params = ::meta_params(refl_func) // returns generic type paramters MetaParamReflectionArtifact { has fields name}
    ::reflect_for(param of generic_params) {
        println("generic param: ", param.name)
    }
}
func_params = ::params(refl_func) // ::params is a keyword that takes a ReflectionArtifact of only function types, return FunctionParamReflectionAritifactArray
::reflect_for(param of func_params) {
    println("param: {", param.name, ",", param.type, "}")
    if (param.type.is_trait_type) { // check if the type of the param is a trait, 
    println("its a trait type: ", param.type.name)
    }
}

refl_package = ::reflexpr(this_package) //this_package is a keyword that specifies this package, ::reflexpr should be able to accept imported package names except the current package name
funcs_package = ::function_members(refl_package) // ::function_members is a keyword, its returns an array of package function reflection artifact array
::reflect_for(func_ of funcs_package) {
	println("function name: ", func_.name)
	println("function return_type: ", func_.return_type)
	println("function params: ", func_.params) // essentially returns the same values as ::params, for meta function, it will be <refl_artifact>.meta_params
}

s = "test string"
if likely(s.len > 0) { // likely is a keyword that give hints to the branch predictor that this branch is likely
    println("string is not empty")
} else {
    println("string is: ", s)
}

arr = ['a', "hello"]

if unlikely(arr.len == 0) { // unlikely is a keyword that gives hint to the munx lang vm/ native implementation that this branch is unlikely to be taken
    println("Array is empty")
} else {
    indx = 0
    loop indx < arr.len {
        println("arr[", indx, "] = ", arr[indx])
        indx = indx + 1
    }
}

//Interfacing with low level C library

library_handle = load_library("object.o") // load_library loads a C shared library / DLL (.o falls back to .so/.dll/.dylib)
if library_handle == null {
    fail("failed to load library: ", "object.o")
}

func_handle = resolve_callable(library_handle, "add_int") // resolve_callable resolves a function in a shared object or dll, returns a function handle that is callable, assume add_int is a c function with structure like 
//int add_int(int, int)
// 

value = func_handle(2, 3) // calles the resolved function underneath and mashalls munx value in c value
println("add_int(2, 3) = ", value)
//value = 5

func_handle_pointer = resolve_callable(library_handle, "set_int") // take set_int to be a function of signature void set_int(int*)
int_value = 100
func_handle_pointer(pointer(int_value)) // creates a pointer for the passed value, int_value is convert to the native int

close_library(library_handle)

//I'll add support for pointers later


trait Human { // trait is a keyword that creates some sort of interface
    name: string
}



func print_name(human: Human) {
    println("humans name is: ", human.name)
}


object Child {
    name: string,
    age: int <constraint>[_ <= 12]
}

object Teenager {
    name: string,
    age: int <constraint>[_ >= 13 && _ <= 19] // new syntax for adding constraits to field values of an object type
}

object Adult {
    name: string,
    age: int <constraint>[_ > 19]
}

object DoesNotMatchByName {
    dob: string
}

object DoesNotMatchByType {
    name: int
}

object DoesNotMatchByNameAndType {
    _some: float
}

print_name(/* any value passed here */) // will fail DoesNotMatchByName, DoesNotMatchByType, DoesNotMatchByNameAndType since they dont match the shape of the
// trait type
// for the other values, Child, Teenager and Adult they will match since they match the needed field types in the language