package sample
load_package lib1
load_package lib2
load_package lib3
load_packages {lib4, lib5, lib6}

string_ = "hello"
character = 'a'
array = ['a', 2 ]

func double(param: int): int{
    return param * 2
}

func is_even(num: int): bool {
    if num%2 == 0 {
        return true
    } else {
        return false
    }
}

func divide(dividend: int,divisor: int): tuple[int, int] {
    return {dividend / divisor, dividend % divisor}
} 

if argv.len == 0 {
    fail("not enough arguments") // fail is keyword, and this is a comment
} else if argv.len < 3 {
    print("arguments are sufficient but something else is need")
}

indx = 0
loop indx != array.len {
    print("value at index ", indx, "is ", array[indx])
}

/*in munx only enums can be matched on*/
enum Gender {
    Male,
    Female
}

object Person {
    name: string,
    age: int,
    height: float,
    gender: Gender
}

func show_person(p: Person): void {
    println(p.name)
}

func show_gender(p: Person): void {
    match p.gender {
        case Gender::Male {
            print("He is a male")
        }
        case Gender::Female {
            print("She is a female")
        }
    }
}

person = Person("Abdul", 10, 15.45, Gender::Male)
show_person(person)

out_pipe = pipe("pipe_id", out)
value = <- out_pipe // pipe extraction operator, blocks till a value is read

print("Value recieved: ", value)

buff = alloc [100] [1,2,3] // allocate an array type of 100 preallocted memory, with 3 values inserted takes no type array store reference to declared objects
delete buff // delete buff

buff = [1,2,3,4]
multiply_factor = 10
factor_simd = simd([multiply_factor] * buff.len) // simd is a keyword for single instruction multiple data, 
s = simd(buff) // only works for arrays of heterogenous primitive types, int, float, char, bool

product = factor_simd * s // should do a simd multiplication

port = env("PORT") // env is a keyword, loads environment variables, returns null when the env_name does not exist
print("port number: ", port)

some_lambda = lambda (s: string, i: int, f: float): string => {
} //has a type Lambda[{string, int, float} => string]

hmap = map[string => Lambda[{string} => int]]{
    "Male" : lambda (s: string): int => { return cast[int](s) * 10 },
    "Female" : lambda (s: string): int => { return cast[int](s) * 20 }
}
value = get(hmap, "Male") // get is a keyword, will return a lambda
null_value = get(hmap, "Test")("Test") // will throw since the callable lambda returned is null because "Test does not exist",
    insert(hmap, {"Test" : lambda (s: string): int => {return s.len * 1000} })// inserts into the map hmap

