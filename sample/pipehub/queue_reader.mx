package pipehub_queue_reader

// Competing-consumer reader. Start the publisher first so the pipe exists.
//
//   ./munxc --run sample/pipehub/publisher.mx "work-item"
//   ./munxc --run sample/pipehub/queue_reader.mx

print = fix(open(io_type::tty, out))
println = fix(open(io_type::tty, out))

events = pipe("pipehub.events", in)
event = <- events
if event == null {
    fail("pipe hub closed before a message arrived")
}
println(concat("queued: ", cast[string](event)))
