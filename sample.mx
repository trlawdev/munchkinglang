    print("arguments are sufficient but something else is need")
}

indx = 0
loop indx != array.len {
    print("value at index ", indx, "is ", array[indx])
}

/*in munx only enums can be matched on*/
enum Gender {
    Male,
    Female
}

object Person {
    name: string,
    age: int,
    height: float,
    gender: Gender
}

func show_person(p: Person): void {
    println(p.name)
}

func show_gender(p: Person): void {
    match p.gender {
        case Gender::Male {
            print("He is a male")
        }
        case Gender::Female {
            print("She is a female")
        }
    }
}

person = Person("Abdul", 10, 15.45, Gender::Male)
show_person(person)
